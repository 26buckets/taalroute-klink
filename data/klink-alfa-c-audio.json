{
  "role": "instruction",
  "voiceId": "h6uBOiAjLKklte8hdYio",
  "voiceName": "Roland - Clear Educational Narrator",
  "targetVoiceId": "0qLmDzgqulxcvv0yf3kg",
  "playbackRate": 1,
  "textSourceSha256": "4abbfc53a9d8cefb12b79ee933e699780c1835744299a6287395f639c08a06ea",
  "clips": {
    "alfa-c-uitleg-3961e33abcbd": {
      "text": "Je oefent met winkel, brood en melk. Tik op Luister.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-3961e33abcbd.mp3",
      "sha256": "6d599fd09daa30ce4691d57540a2cbb52973c665fe4f8d247fc2141b0c8c5780",
      "duration": 4.16,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-8f406c2ba866": {
      "text": "Je bent klaar. Je hebt geoefend met winkel, brood en melk.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-8f406c2ba866.mp3",
      "sha256": "24d8a1e499e0d90ef4d21a1ea527561afbb24aaf5c848e285509d5b30146a8b6",
      "duration": 4,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-9e8cf5313c56": {
      "text": "Kijk naar de foto. Tik op Luister. Kijk ook naar het woord.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-9e8cf5313c56.mp3",
      "sha256": "8fe8acf51fe5fe87ae5af563b29984da2a1b37269b7048535a557aebdb520245",
      "duration": 4.72,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-c0d2c04700b4": {
      "text": "Je hebt geluisterd. Tik op Verder.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-c0d2c04700b4.mp3",
      "sha256": "1982ef40a3eb33d020d177b9bb987cfa1936afcff842e30a72e5c40fd35de10b",
      "duration": 2.56,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-60c4422b9aa3": {
      "text": "Tik op Luister. Kijk naar de drie foto’s. Tik op de foto die bij het woord hoort.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-60c4422b9aa3.mp3",
      "sha256": "2cec58a5b2589c76dcf27d636e5c14961405d78f2ef603d82d49bcde811b319a",
      "duration": 5.6,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-0bbb4ca53380": {
      "text": "Kijk naar het woord. Tik op Luister.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-0bbb4ca53380.mp3",
      "sha256": "ec65bd718a97bd961587a6352bcfdf87140496551a8f5414345e99868117c1fe",
      "duration": 2.8,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-c9b01a3d3b06": {
      "text": "Tik op Luister. Kijk naar de foto’s, één voor één. Welke foto hoort bij het woord?",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-c9b01a3d3b06.mp3",
      "sha256": "9b9783c8eb0fe62370f4c07d749b96b6a9ea645ebf9506de5fe2cececcfb1f76",
      "duration": 6.16,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-bbab2f9893ef": {
      "text": "Deze foto past niet bij het woord. Tik op Luister. Tik op een andere foto.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-bbab2f9893ef.mp3",
      "sha256": "0377fbad7d8b2196ee9c5f3acbc7621748b73667a0d327cb97cb6f4251fa319d",
      "duration": 5.84,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-336827049e78": {
      "text": "Dat klopt. Tik op Verder.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-336827049e78.mp3",
      "sha256": "7282fa64b7d55d7e8e34592225fd2811b63ae460ea9e593f4813503ccdfd9608",
      "duration": 2,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-aaf5866103ec": {
      "text": "Tik op Nu jij.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-aaf5866103ec.mp3",
      "sha256": "79a53f37f80dcc3cceed3c9aa1c7ffcfa578277107bc010f2e3a232772aff43b",
      "duration": 1.6,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-493cbc06d8d2": {
      "text": "Tik op Luister. Je ziet twee kaartjes. Tik op het kaartje met het begin van het woord. Tik dan op het andere kaartje.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-493cbc06d8d2.mp3",
      "sha256": "f0edeaa61ffe47c3b96559796bc965b5b4a0a1589ed833b64135807ae9a3bc81",
      "duration": 7.76,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-9d671750ce3b": {
      "text": "Tik op Luister. Let op het begin van het woord. Met Eén terug haal je het laatste kaartje weg.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-9d671750ce3b.mp3",
      "sha256": "a84af457a1da70e5a9780b498791e4ea2ba337c8cd512b5ac8a596e2c56f2ca6",
      "duration": 6.4,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-59a207e8a2f1": {
      "text": "Tik op Eén terug tot de vakjes bovenaan leeg zijn. Tik op Luister. Maak het woord opnieuw.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-59a207e8a2f1.mp3",
      "sha256": "d763fa25e31fdd197c6f6b4e81918a4d5ec13d4e38bf0fa6df73a205cd92abe8",
      "duration": 6.88,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-d62995acdb28": {
      "text": "Tik op Luister. Kijk naar de drie zinnen. Tik op de zin met dezelfde woorden.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-d62995acdb28.mp3",
      "sha256": "be21f5e6166fd68336e015eff20455031742e7bf859541d229e748dc53a13c29",
      "duration": 5.28,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-ba99b5d9c3d7": {
      "text": "Kijk naar de zin. Tik op Luister.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-ba99b5d9c3d7.mp3",
      "sha256": "8ac86eca5063bc644ee1d4384cf65c10c60badc246e56fcb89ef751e2b790f64",
      "duration": 2.72,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-628e36114990": {
      "text": "Tik op Luister. Zoek het eerste woord dat je hoort. Lees daarna de hele zin mee.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-628e36114990.mp3",
      "sha256": "dbe16f1cff0c015a740f5b2610b9bcee7c7492197feb1a36bb08e9b662bad7a7",
      "duration": 5.92,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-98998ac541c2": {
      "text": "Dit is niet de zin die je hoort. Tik op Luister. Tik op een andere zin.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-98998ac541c2.mp3",
      "sha256": "aefefbd5980a8f1fe8c8d7c6a7bcc60d7cf3fd92da4c9a07765ac3b1a556ae9b",
      "duration": 4.88,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-9d75de3ee976": {
      "text": "Tik op Luister. Tik op het kaartje met het eerste woord. Tik daarna op de volgende woorden.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-9d75de3ee976.mp3",
      "sha256": "53496542f96bd3d83de30ec8056d2bc97c357153058fc748d4933aec0f9b5f8d",
      "duration": 6.08,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-6c19c89d10b3": {
      "text": "Tik op Luister. Let op het eerste woord. Met Eén terug haal je het laatste kaartje weg.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-6c19c89d10b3.mp3",
      "sha256": "33aa4096f0dc7d78707fb0fb41f38be3004291f28f8fe056af3d372d28f09dd1",
      "duration": 6,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-d946c03d8ce6": {
      "text": "Tik op Eén terug tot de vakjes bovenaan leeg zijn. Tik op Luister. Maak de zin opnieuw.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-d946c03d8ce6.mp3",
      "sha256": "848500505b3faefed82e612f6766f569d320234d7622e6302b6d163fdf36a1cf",
      "duration": 6.72,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-59b54695c336": {
      "text": "Tik op Luister. Kijk naar de drie foto’s. Tik op de foto die bij de zin hoort.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-59b54695c336.mp3",
      "sha256": "a6423a688337d28cb84c0459bffb02110be2eae19b8a9199d1f008521183fb95",
      "duration": 5.68,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-12ae571e1f4b": {
      "text": "Tik op Luister. Let op het laatste woord. Welke foto hoort bij dat woord?",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-12ae571e1f4b.mp3",
      "sha256": "89ce2eb5b0292f1a0245637d05e7b6bfa2d62fbd1c3e64a0feb636ab7a7101e6",
      "duration": 5.36,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-ff5f28a10a02": {
      "text": "Deze foto past niet. Tik op Luister. Let op het laatste woord. Tik op een andere foto.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-ff5f28a10a02.mp3",
      "sha256": "0cbf8173c5f7244d58d7687f7a9b2ca7431ea65ded49cf25ff03ac7edb1b19ab",
      "duration": 6.72,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-f1cbe1a8c70c": {
      "text": "Je oefent met auto, bus en fiets. Tik op Luister.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-f1cbe1a8c70c.mp3",
      "sha256": "a85c488d16f6189d867c08d77077ab18323c3cb2d2d1a6b8b3a33acc3550e4db",
      "duration": 4.32,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-a980aed9e42a": {
      "text": "Je bent klaar. Je hebt geoefend met auto, bus en fiets.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-a980aed9e42a.mp3",
      "sha256": "33eddd4cadfa296f7918e3a86b69582cf908668117f648ffeee187f9f343fa99",
      "duration": 4.08,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-23d570bfa88d": {
      "text": "Sommige zinnen beginnen hetzelfde. Tik op Luister. Let op het laatste woord. Kijk welke zin dat woord heeft.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-23d570bfa88d.mp3",
      "sha256": "f9fd5656e94bc4c5517ba9b787d9406835f0b3a38a7cba95eaaf8e6b0ca9b3f7",
      "duration": 6.88,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-5e46b7714162": {
      "text": "Je oefent met kamer, deur en raam. Tik op Luister.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-5e46b7714162.mp3",
      "sha256": "bfae07633ba0a65755cc19956923c19566115c7fa580a861ae797a43b5118223",
      "duration": 4.08,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-2206a7a2acc6": {
      "text": "Je bent klaar. Je hebt geoefend met kamer, deur en raam.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-2206a7a2acc6.mp3",
      "sha256": "08b1558a3bc42769f814e504b988efaf1d9989a15edaf39cb29b98124441798a",
      "duration": 3.92,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-5fe6081e9283": {
      "text": "Tik op Voorbeeld. Bekijk het woord of de zin.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-5fe6081e9283.mp3",
      "sha256": "e20c09334b7b6477d28b3c644fa31b12194bb71370b820f867290d73678066cf",
      "duration": 3.68,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-324cb88fad0e": {
      "text": "Tik op Help. Je krijgt een tip.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-324cb88fad0e.mp3",
      "sha256": "999c541a93e9b506fe9646120c007f52081f98934675517e326ff147cc977668",
      "duration": 2.24,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-a6c20b2b1321": {
      "text": "Tik op Eén terug. Het laatste kaartje gaat weg. Wil je nog een kaartje weghalen? Tik weer op Eén terug.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-a6c20b2b1321.mp3",
      "sha256": "2ce188a2767aa46dc60150414f76e78046725ad3d48cd259957d72991c58d694",
      "duration": 6.8,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-e7729601a8b7": {
      "text": "Tik op Luister. Probeer het nog een keer. Wil je hulp? Tik op Help.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-e7729601a8b7.mp3",
      "sha256": "b77b57b6a75b477a970358f2fc0046062664457e677b910f9d204c29e1186e5f",
      "duration": 4.8,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-e0dbe7d0dfff": {
      "text": "Tik op Eén terug tot de vakjes bovenaan leeg zijn. Tik op Luister. Begin opnieuw.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-e0dbe7d0dfff.mp3",
      "sha256": "dbe0e9cc868ed19e3094cb7c2a84c8599f60312d9a523ba1582e35850798d9ab",
      "duration": 6.24,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-947da054ef5c": {
      "text": "Hoor je niets? Zet het geluid van je laptop aan. Tik daarna op Luister.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-947da054ef5c.mp3",
      "sha256": "59e0d5b85ecd72d17f2ffca8846224e67bfc728853f93c1d6732a7f5012324a4",
      "duration": 4.96,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-ec5a57fba4ac": {
      "text": "Het geluid werkt nu niet. Probeer het later nog een keer.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-ec5a57fba4ac.mp3",
      "sha256": "bac78c54d56dc909d47b50155eba9b4ee763ca34db33057b08a762941e2452b1",
      "duration": 3.2,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    },
    "alfa-c-uitleg-492923edfa7b": {
      "text": "Je kunt later weer oefenen.",
      "src": "/package-audio/alfa-c-uitleg-20261027/alfa-c-uitleg-492923edfa7b.mp3",
      "sha256": "e06374f68fca79b20afed8dc3b8ef2513d6e78acdfe5d6eb0db341252bd42f6b",
      "duration": 1.6,
      "voiceId": "h6uBOiAjLKklte8hdYio"
    }
  },
