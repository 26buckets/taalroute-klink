[
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-662494a2c315.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Kijk naar het woord. Typ het woord na.",
    "sha256": "c9606e1291da7b1b0f455fcdd4dea9de4a876bbc0476b889866fb7cdd4eb3a92"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-e82b989084a1.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Lees het woord. Luister als je hulp nodig hebt.",
    "sha256": "a4a38ae477361d1fd218dafebe5385eefcfd06c4a277fd990dfadd6aa73851ce"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-803e0b70a7c4.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Kijk naar het woord. Leg de letters in de goede volgorde.",
    "sha256": "494aec380c82b89e60337d527fe496c93498cd3d458bf7cd1f28820910c5790f"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-eac39aaa0ebd.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Kijk naar het woord. Maak het woord met de letters.",
    "sha256": "c6799a6f63311fc4dd53c8fa5d601a54d00605a7c407c743a97c843854afdac1"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-f193b35fda51.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Luister naar het woord. Maak het woord met de letters.",
    "sha256": "a74d843c39139fcbf2d851f89ab91d3b9f78114de65f7d3688a5be99d01c1ec0"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-f30ca4bc7abf.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Luister. Tik op het woord dat je hoort.",
    "sha256": "5db1c20c0506d5591ed30a7604564ce06ad538ec867b9fc0ed413eb472ba179e"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-aba0ad5044ab.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Kijk naar de letters. Zet elk woord in de goede bak.",
    "sha256": "41ede08a5932fa7b6f1f0520df0777e9b1af0459a5742317b7c41701c0791c4c"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-245168b94ba3.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Kijk naar het woord. Lees de uitleg samen met je docent.",
    "sha256": "b62d613a1c7cd29ebea0a94c4b5deece96e8f5f726c09799725d7edb077147b8"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-e9565f105f3d.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Kies de letters die passen.",
    "sha256": "76842fcc755cbefe0750e298be0d483840b8f3720313c1f11238fd1fb1dbe10b"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-f1e80ab41f43.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Luister. Schrijf het hele woord.",
    "sha256": "c7689f211a34271e9acb367b444c48794e1bcbbd203150328d743154c174e664"
  },
  {
    "src": "/package-audio/kijk-luister-20261029/KEL-INS-0b8fcd7a329d.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Kijk en luister. Speel het geluid nog een keer af als je wilt.",
    "sha256": "e2d4344db8da387071571c4a71a6a7eb454f1df4f26e5dfb13453aad6a3c66f9"
  },
  {
    "src": "/package-audio/kijk-luister-20261029/KEL-INS-09336336e4fa.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Je kunt nog een keer luisteren. Ga verder als je klaar bent.",
    "sha256": "6f6854626a8274c7c7c2e29fac3cf1d3785ee79698b93deb12df509300fe91e7"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-96d15ed91093.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Zoek de paren. Kies een woord en een foto die bij elkaar horen.",
    "sha256": "0289a1f93dc4d2082dd5932d8f049ff2861bfe0bed7b26535b218ad8eb5bcd0d"
  },
  {
    "src": "/package-audio/productie-instructies-20261029/KLINK-INS-312000524508.mp3",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "text": "Luister. Tik op de foto die bij het woord hoort.",
    "sha256": "2cd9dc8b775f1a0822be9f1c29ec28442b007ece526ede808bb43bba7c330677"
  },
  {
    "text": "Je hebt het niet warm. Luister en typ het woord.",
    "src": "/package-audio/klink-writing-20261101/KSW-AC-HT-007-instruction.wav",
    "voiceId": "h6uBOiAjLKklte8hdYio"
  },
  {
    "text": "Dit is kleding. Luister en typ het woord.",
    "src": "/package-audio/klink-writing-20261101/KSW-AC-HT-043-instruction.wav",
    "voiceId": "h6uBOiAjLKklte8hdYio"
  },
  {
    "text": "Dit kun je eten. Luister en typ het woord.",
    "src": "/package-audio/klink-writing-20261101/KSW-AC-HT-047-instruction.wav",
    "voiceId": "h6uBOiAjLKklte8hdYio"
  },
  {
    "text": "Je vaart hiermee op het water. Luister en typ het woord.",
    "src": "/package-audio/klink-writing-20261101/KSW-AC-HT-088-instruction.wav",
    "voiceId": "h6uBOiAjLKklte8hdYio"
  },
  {
    "text": "Je krijgt dit na een vraag. Luister en typ het woord.",
    "src": "/package-audio/klink-writing-20261101/KSW-AC-HT-100-instruction.wav",
    "voiceId": "h6uBOiAjLKklte8hdYio"
  },
  {
    "text": "Dit staat om een tuin. Luister en typ het woord.",
    "src": "/package-audio/klink-writing-20261101/KSW-AC-HT-082-instruction.wav",
    "voiceId": "h6uBOiAjLKklte8hdYio"
  },
  {
    "src": "/package-audio/klink10-listening-20261102/audio-3d70225b669935ef.bin#bytes=1646489,31136",
    "text": "Luister goed. Kies het beste antwoord.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "49f91d9d7845c9fd77a769c20a2ca3ff3cf4fd1b9cf3e6e77fe964f3af757daa"
  },
  {
    "src": "/package-audio/klink10-listening-20261102/audio-6fc1915e0c1e07df.bin#bytes=259336,41171",
    "text": "Luister naar de ander. Welke reactie past?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "beb5cebe2f647dc2b71564270cbaf56b4497f67cc8f6d32f3ec481576d9b95e0"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=0,62926",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'morgen'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "6c700ff3c8d5498b0bf4fa4169b5d195ddb07b8700278f7717741b3ce8ce1e92"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1016603,63764",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'dezelfde'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "d87a37b2efdb9f86681d8cfbf36dbb06dd9c5af101d2d109554e1758af3d8226"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1080367,71708",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'verwarming'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "bf3c13764b35a6a657f0db87097dfc9785dd5567f8531c1d07e68c123e69bf32"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1152075,64598",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'vriend'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "2412f997c246602e4e6977aa43a4847ce9e358098ce813ac800a9d362c36f1c7"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1216673,61254",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'Hallo'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "12e90e464eb85b3aa548a7127de7ac35786c399dd93f79ed7d5ef65be24c8523"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1277927,49538",
    "text": "Luister naar de opname. Kies precies wat je hoort.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "d7bac093416e3adfbac6ccd36b36190852b3f8b67a8991c8bdb9a9518f9be2c9"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1327465,62091",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'school'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "3ecc2d6a41d25da90e4c05e37773ee4867849ed5f15b49d66455f34c38ad5d90"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1389556,61253",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'melk'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "fa3a483af52f7c3966bdcf4774995b34302d49404cefc25d55d9e59b481a6d29"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1450809,54552",
    "text": "Luister naar de opname. Typ precies wat je hoort.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "a23dfcd91c019df419ae47e360c73dcc429b1a2d8323c8f3ac5e32ae801158e5"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=147361,106004",
    "text": "Maak een eigen zin met dit woord. Zeg de zin hardop of typ hem. Bekijk daarna het voorbeeld.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "e0e78fbb860ae6b5a0a0c8c93a94bfe5478f2a87c6bfc3aa03154786e5c6401f"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1505361,67940",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'woon'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "b205b9064f1d0ead601fd53dbef1973766ddc5f4c3c3dc4c947f7df27dd0aba3"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=1573301,64597",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'vloer'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "06b41e7ab7fa3bff75330935a49a10a8cc7af4b755787b784fb051a553d6d6bd"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=275285,62094",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'vertellen'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "7ff4fe6c7a282bfcd33805777a2b9e6d5ee5d8bfe70cb69703660057ca339a41"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=337379,67529",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'verplaatsen'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "5c8e57e1e6870e5f53a3240cae291fe8a13bc9a0f923acba7fdf0d371f0fc6cf"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=404908,62929",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'uitleggen'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "a9d317ba24d1889591d489c3972b63485366de1bd7e17689fb41f78578be83f8"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=467837,72549",
    "text": "Maak dezelfde zin als in de opname. Zet de kaarten in de juiste volgorde.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "437800ccb5e4e2a4908b643fdb95d4794ecdee6def8546a0e3563cb2c85b4538"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=540386,64598",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'woning'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "85e978a522fc4a030a3f35c48a99fc14958f81b8c46b75266ddf1142a4ef52f8"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=604984,67528",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'uitnodigen'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "ec60cbe603104e14f529cefae30648a3b669fb8314d1c4e38381306b4472d0c5"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=62926,63765",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'Rotterdam'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "cb61600599c22a24173c24717fa8b4b0b3070e9c9a1e5c00934d29f5ef9c9dd3"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=672512,60836",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'kamer'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "6756d1e87e0d035800107883834956a76979da1a39a16bc45fba530813d5612b"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=733348,68785",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'schoongemaakt'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "e67fba6fdacf15eacc0f0369204a586e7a1289b0330570977e27a58ff573f8a8"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=802133,65014",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'heet'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "2f8ef2f79b7a6258be06eb90ca07026e5334939fde48c2cf274888b0fe7f9915"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=867147,27367",
    "text": "Kijk naar de zin en typ hem na.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "e721e218090370bfbe739dd445ede55617f430313f677e69962363f74aa95413"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=894514,61253",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'ziek'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "393e58f096e3e0a6ba3c0f426a8c7e8fca65024bec3b873b75fac63e6a739620"
  },
  {
    "src": "/package-audio/klink10-sentences-20261102/audio-c3a112e29bbb4366.bin#bytes=955767,60836",
    "text": "Luister naar de hele zin en lees mee. Tik op het woord 'brood'.",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "25c072aefd89ba914d175100e5a8a6c06a68bb5893cd2c3fa48aa24ed7c88eb2"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-09f6239e1572f2a3.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Wat pakt Sara voordat ze naar school fietst?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "c146dd08a38f085ee3d85672c42d5ed247ab385ce57478fa529e75428747797c"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-a1c8c65f34924332.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Wat koopt Omar bij de bakker?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "05038de86c9f7845481d8a1275aefefb0a64c2dda781abcde5353861865cd536"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-cc0b600144991189.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Wat doet Fatima aan het einde van het verhaal?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "2dcdcdf053de6c00bbb52dd9656c4fa6537d1595dc99d4e44e86a00351295cba"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-53f20f78481f214c.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Met wie neemt Nora contact op?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "84f6cbff9ea975a47871c43867ca79de76b7c4ca090c21283e52692a05659b45"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-72cecc1b16414a79.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Wat doet Bilal nadat hij een kaartje heeft gekocht?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "e13c9e24c7d2a9980bdce9f9af449e3791e40fddad7cc3e0ca19e2f16cc4c2c3"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-2ca8124c1b2b2ae2.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Wat doet Elif met het boek?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "17ef5ebc97a8bda50ff9b7ddf76fc3e37cbc62a95123c3613907efc898f254f0"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-d0d1da1517533f44.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Waar gaat Hassan naartoe?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "e25357a1a67aee0bfd3c412edf2f5a008497029fe581d67982c7bc0dc143bdc8"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-cc597ff90e860903.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Wat gebeurt er nadat Leila haar zus heeft gebeld?",
    "voiceId": "h6uBOiAjLKklte8hdYio",
    "sha256": "4beba1fad89c7c38a10b6f30063f4c790d50ff530c62b51c09d19bd1f5d7e1c1"
  },
  {
    "src": "/package-audio/klink10-text-evidence-20261102/k10te-7f54d49be168beba.mp3",
    "text": "Lees de vraag. Tik op alle woorden van de zin met het antwoord. Wat doet Amir nadat zijn collega de werkplek heeft laten zien?",
