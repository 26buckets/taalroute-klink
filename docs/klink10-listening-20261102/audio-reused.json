[
  {
    "id": "k10l-7a9ad3032ba1aecc",
    "text": "Donderdagmiddag",
    "src": "/package-audio/woordvormen-20261101/WA-8d81f0e35dcd.mp3",
    "sha256": "650b0339cbe54a5f56373a2fd081c8905271acacc75cfcfb917747c9b2711f16",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-f560fc0b1732a759",
    "text": "Vrijdagochtend",
    "src": "/package-audio/word-listening-20261101/words-16a04cb9d3ef3d73.bin#bytes=773706,22303",
    "sha256": "838f7c4b576a2739b2030ab41d41b8ee0d58fd3d71a2e44cdde0a6c603d999b1",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-d54dd818b12e7e7a",
    "text": "Vrijdagmiddag",
    "src": "/package-audio/woordvormen-20261101/WA-bd4249c33c27.mp3",
    "sha256": "63380f1179edc2465cdac5acce3eb590a70fe39a6e3e7e42c7b09fcc672be270",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-7ffb3ef58e645402",
    "text": "Mag ik jouw boek lenen?",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-5f7e2296cb998211-1.mp3",
    "sha256": "0506aebfb9b55a428c7a8ddcbdfaff21d7f0ca86eedc9531b36e9e79a649c324",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-5f7e2296cb998211-1"
  },
  {
    "id": "k10l-c08fbb0a67dfc27a",
    "text": "Ja, dat mag.",
    "voiceId": "5sOQIpQbG4XwqbEbuGNB",
    "src": "/package-audio/dialogue-repair/klink-dialogue-5f7e2296cb998211-2.mp3",
    "sha256": "234ec717edb85a718937111cdb6a27c129714108ec33138e3394c8709f0382c1",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-5f7e2296cb998211-2"
  },
  {
    "id": "k10l-5061ac118ccb9066",
    "text": "Wanneer wil je het terug?",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-5f7e2296cb998211-3.mp3",
    "sha256": "122d62ddb31e1a869376441774bf724521cc82f3f94ad8089ab74b24a89a7eca",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-5f7e2296cb998211-3"
  },
  {
    "id": "k10l-ccd0df09966289be",
    "text": "Morgen na de les.",
    "voiceId": "5sOQIpQbG4XwqbEbuGNB",
    "src": "/package-audio/dialogue-repair/klink-dialogue-5f7e2296cb998211-4.mp3",
    "sha256": "158992e5bc81b8b34dbe2f86598a46a2e2a5a35b7bdd326f933cd27ad556c340",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-5f7e2296cb998211-4"
  },
  {
    "id": "k10l-307ceb67c18b713d",
    "text": "Wil je een kom soep?",
    "voiceId": "HGg2c3eDR1tMpbtDRAzL",
    "src": "/package-audio/dialogue-repair/klink-dialogue-c2c076150b6d8c31-1.mp3",
    "sha256": "d49ee6939850a3f76b9698188f93cd4d4d1e0f98d622065068a63e40b305ca3f",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-c2c076150b6d8c31-1"
  },
  {
    "id": "k10l-383921b316cf3caa",
    "text": "Ja, graag.",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-c2c076150b6d8c31-2.mp3",
    "sha256": "76da5cc8dff2e1d5b59011dc0f3eddd3b7b14747551de5b27686163348ed6b46",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-c2c076150b6d8c31-2"
  },
  {
    "id": "k10l-3b73bc1a18ba9ff1",
    "text": "Wil je er brood met kaas bij?",
    "voiceId": "HGg2c3eDR1tMpbtDRAzL",
    "src": "/package-audio/dialogue-repair/klink-dialogue-c2c076150b6d8c31-3.mp3",
    "sha256": "06fc532399d094fc68ec9547f4c505d0be23d51af7c9a7f3173a55ed69aa0625",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-c2c076150b6d8c31-3"
  },
  {
    "id": "k10l-2271585e6596e166",
    "text": "Nee, alleen soep, dank je.",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-c2c076150b6d8c31-4.mp3",
    "sha256": "d791be9a38d95f265284a445949be240e1252393917514553784b7acd3bd77a6",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-c2c076150b6d8c31-4"
  },
  {
    "id": "k10l-43e740951fbb5a98",
    "text": "Hallo, wat is jouw naam?",
    "voiceId": "5sOQIpQbG4XwqbEbuGNB",
    "src": "/package-audio/dialogue-repair/klink-dialogue-4794aca04969d687-1.mp3",
    "sha256": "fa4057d6ea76f1ab8115b6d0bf18f4ecdaaa3ea57340b4b229fac63f4101f39e",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-4794aca04969d687-1"
  },
  {
    "id": "k10l-46e0b3ecbbab5073",
    "text": "Mijn naam is Youssef. En jij?",
    "voiceId": "HGg2c3eDR1tMpbtDRAzL",
    "src": "/package-audio/dialogue-repair/klink-dialogue-4794aca04969d687-2.mp3",
    "sha256": "d80bdb5933f8b2f68224b6b4d13961c070a8ad8bc7e01f02f72f25b7721aaac3",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-4794aca04969d687-2"
  },
  {
    "id": "k10l-b6ee374414e03240",
    "text": "Ik ben Elena. Is deze stoel vrij?",
    "voiceId": "5sOQIpQbG4XwqbEbuGNB",
    "src": "/package-audio/dialogue-repair/klink-dialogue-4794aca04969d687-3.mp3",
    "sha256": "9b96936c0d19ca7bdb260cfe6a5d657b4b6a613d50584f1aedb6bf829aa29c80",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-4794aca04969d687-3"
  },
  {
    "id": "k10l-06d9734a09380f03",
    "text": "Ja, kom maar naast mij zitten.",
    "voiceId": "HGg2c3eDR1tMpbtDRAzL",
    "src": "/package-audio/dialogue-repair/klink-dialogue-4794aca04969d687-4.mp3",
    "sha256": "d9f69d607b04d0eb082d351827b99c0f4f5f47eb482259872295dc16cd4f44dd",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-4794aca04969d687-4"
  },
  {
    "id": "k10l-fec600204ac7b818",
    "text": "Ik zie maar één laars. Waar is de andere?",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-32bf8a180da8725b-1.mp3",
    "sha256": "4e0635137b365e9d6df8dfb0c53f9fe6a18f6c2866a591d06a5756b14669fab0",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-32bf8a180da8725b-1"
  },
  {
    "id": "k10l-8597ce2c70a81aeb",
    "text": "Kijk eens onder de stoel.",
    "voiceId": "HGg2c3eDR1tMpbtDRAzL",
    "src": "/package-audio/dialogue-repair/klink-dialogue-32bf8a180da8725b-2.mp3",
    "sha256": "525f628746c16049c1ef9025bd76180395f5f4e9945c43dc82eaf88ff02b4277",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-32bf8a180da8725b-2"
  },
  {
    "id": "k10l-0279dd87a7b1cb96",
    "text": "Ja, daar staat hij. Dank je.",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-32bf8a180da8725b-3.mp3",
    "sha256": "98e61c028d98c1d3ffcb09d0efa6d401577ea278c84c65c952eee715e44c3475",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-32bf8a180da8725b-3"
  },
  {
    "id": "k10l-7258de77e0e3aa91",
    "text": "Graag gedaan.",
    "voiceId": "HGg2c3eDR1tMpbtDRAzL",
    "src": "/package-audio/dialogue-repair/klink-dialogue-32bf8a180da8725b-4.mp3",
    "sha256": "aa0feeb06135e94d1708958e053536c6dacc7de63abb94dbed770d83bbb4a998",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-32bf8a180da8725b-4"
  },
  {
    "id": "k10l-5fcce770a09690d1",
    "text": "Wil je thee?",
    "voiceId": "YUdpWWny7k5yb4QCeweX",
    "src": "/package-audio/dialogue-repair/klink-dialogue-6dad30938477beff-1.mp3",
    "sha256": "d322af489e1907d7ca4016ab9e6c81009c23aeb77cd37fb4770320069aa29a4d",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-6dad30938477beff-1"
  },
  {
    "id": "k10l-bd3fa450f2fdb90d",
    "text": "Ja, graag. Een kleine kop.",
    "voiceId": "AyQGttFzg1EY7EIKkpHs",
    "src": "/package-audio/dialogue-repair/klink-dialogue-6dad30938477beff-2.mp3",
    "sha256": "5086fc7856bcdcd0b001ae05c88c7bc1e4691ab50071647f727831d5c468948e",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-6dad30938477beff-2"
  },
  {
    "id": "k10l-b20ed7993870e58f",
    "text": "Met suiker?",
    "voiceId": "YUdpWWny7k5yb4QCeweX",
    "src": "/package-audio/dialogue-repair/klink-dialogue-6dad30938477beff-3.mp3",
    "sha256": "e8f485e71b4d150258f80a7e111fffd1779d19cffa0cd74309baf55ca275783d",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-6dad30938477beff-3"
  },
  {
    "id": "k10l-03cbc80902f76b8d",
    "text": "Nee, zonder suiker, dank je.",
    "voiceId": "AyQGttFzg1EY7EIKkpHs",
    "src": "/package-audio/dialogue-repair/klink-dialogue-6dad30938477beff-4.mp3",
    "sha256": "96ca5bb90040d87e5dfca3397c588b326f65bb1d9fe4291b359d07b887cc9a4b",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-6dad30938477beff-4"
  },
  {
    "id": "k10l-f357c74fcfc8881d",
    "text": "Ik neem deze rok.",
    "voiceId": "YUdpWWny7k5yb4QCeweX",
    "src": "/package-audio/dialogue-repair/klink-dialogue-099b5a173854f005-1.mp3",
    "sha256": "fa46777a468027ffea6e8cbc791c52356729119046c9ce41fede2e2b483844d7",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-099b5a173854f005-1"
  },
  {
    "id": "k10l-8b4f7c33b0107507",
    "text": "Dat is goed.",
    "voiceId": "D6MRWCKoavI2xUJXmaCb",
    "src": "/package-audio/dialogue-repair/klink-dialogue-099b5a173854f005-2.mp3",
    "sha256": "b72ef0f2215953f5affab87d54c87000354723c3e5d54cee747c601a56e5ef43",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-099b5a173854f005-2"
  },
  {
    "id": "k10l-c39bf68be2d3a91c",
    "text": "Mag ik de bon erbij?",
    "voiceId": "YUdpWWny7k5yb4QCeweX",
    "src": "/package-audio/dialogue-repair/klink-dialogue-099b5a173854f005-3.mp3",
    "sha256": "16fa0d2427c869c7dc2bf61d4c1ea2b1a720f2f612cbcc2fd5c42ebc93c92f0d",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-099b5a173854f005-3"
  },
  {
    "id": "k10l-b08d77548cfb09b5",
    "text": "Natuurlijk. Hier is de bon.",
    "voiceId": "D6MRWCKoavI2xUJXmaCb",
    "src": "/package-audio/dialogue-repair/klink-dialogue-099b5a173854f005-4.mp3",
    "sha256": "10a0db206a89241c9219929b5beb16c5acd01637ababb039223f582e0b1f73e5",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-099b5a173854f005-4"
  },
  {
    "id": "k10l-4758ff869327f9c2",
    "text": "Kom je deze week langs?",
    "voiceId": "gCJROUe9eMZaWlhNj1z0",
    "src": "/package-audio/dialogue-repair/klink-dialogue-17aa25708b6699a6-1.mp3",
    "sha256": "03456ecd13a0fa219b7701685e226d0336ad140846820e24eae1249d909e7f62",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-17aa25708b6699a6-1"
  },
  {
    "id": "k10l-2e3dc449461912b1",
    "text": "Ja. Is dinsdag goed?",
    "voiceId": "YUdpWWny7k5yb4QCeweX",
    "src": "/package-audio/dialogue-repair/klink-dialogue-17aa25708b6699a6-2.mp3",
    "sha256": "27e110e2a6bf16741e249368fb2d1fa9b8acb8a428853b865bd8ec5b66bdbfaa",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-17aa25708b6699a6-2"
  },
  {
    "id": "k10l-8fc6354a04e38633",
    "text": "Ja, om acht uur?",
    "voiceId": "gCJROUe9eMZaWlhNj1z0",
    "src": "/package-audio/dialogue-repair/klink-dialogue-17aa25708b6699a6-3.mp3",
    "sha256": "3d9aec079927b646756999b9378fee2cbfc8d881ae6cbded5558baa8a7daf2f9",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-17aa25708b6699a6-3"
  },
  {
    "id": "k10l-acf0018acc846ce3",
    "text": "Goed, tot dinsdag om acht uur.",
    "voiceId": "YUdpWWny7k5yb4QCeweX",
    "src": "/package-audio/dialogue-repair/klink-dialogue-17aa25708b6699a6-4.mp3",
    "sha256": "b33e4138d571face451e504f37e4301f46b9298d5870c94807f36647088ab1bd",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-17aa25708b6699a6-4"
  },
  {
    "id": "k10l-1bacf773acc4be6a",
    "text": "Gaat deze bus naar het station?",
    "voiceId": "0qLmDzgqulxcvv0yf3kg",
    "src": "/package-audio/dialogue-repair/klink-dialogue-e09966d04858ee8b-1.mp3",
    "sha256": "2822642f44b0ab646ec605870b9d94cae305caf7e0d0a7f842daa28e8546f6e9",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-e09966d04858ee8b-1"
  },
  {
    "id": "k10l-f8d24a8933f48513",
    "text": "Ja, stap maar in.",
    "voiceId": "7qdUFMklKPaaAVMsBTBt",
    "src": "/package-audio/dialogue-repair/klink-dialogue-e09966d04858ee8b-2.mp3",
    "sha256": "27850ee147f9915ddca23823a4b396aff936b9f45c00b7d90a06fe0adb40b143",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-e09966d04858ee8b-2"
  },
  {
    "id": "k10l-a9ed4b74948d2730",
    "text": "Dank u wel.",
    "voiceId": "0qLmDzgqulxcvv0yf3kg",
    "src": "/package-audio/dialogue-repair/klink-dialogue-e09966d04858ee8b-3.mp3",
    "sha256": "449c1cb54adfff67035d9cd531a0f086ea220784224926f34030920526ff3bb5",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-e09966d04858ee8b-3"
  },
  {
    "id": "k10l-d2b247593577884c",
    "text": "Graag gedaan.",
    "voiceId": "7qdUFMklKPaaAVMsBTBt",
    "src": "/package-audio/dialogue-repair/klink-dialogue-e09966d04858ee8b-4.mp3",
    "sha256": "b6d1249ca1e2d34f3b1da151821668f8d4d1c7f8fd49b104dcbceec26048f32c",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-e09966d04858ee8b-4"
  },
  {
    "id": "k10l-3b100bea87abb5fd",
    "text": "Is deze pet van jouw kind?",
    "voiceId": "7qdUFMklKPaaAVMsBTBt",
    "src": "/package-audio/dialogue-repair/klink-dialogue-96c6591474d5e5b0-1.mp3",
    "sha256": "36b6d7e305c404ec151db3db2308c0a20c09569197c099e3d40fb52452aedbc4",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-96c6591474d5e5b0-1"
  },
  {
    "id": "k10l-6d8eacf5c3bf432c",
    "text": "Ja, die zochten we.",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-96c6591474d5e5b0-2.mp3",
    "sha256": "d791af1d841d06d044fb552dcf8ccf1332a9b54677c41645c08c400abf28946c",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-96c6591474d5e5b0-2"
  },
  {
    "id": "k10l-0faabebdab660222",
    "text": "Hij lag op de stoel.",
    "voiceId": "7qdUFMklKPaaAVMsBTBt",
    "src": "/package-audio/dialogue-repair/klink-dialogue-96c6591474d5e5b0-3.mp3",
    "sha256": "fd9230d44cebd40285ccd57e426562a9422eb39a502a1b06b384f2dff495f2ac",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-96c6591474d5e5b0-3"
  },
  {
    "id": "k10l-76de084f4621db9c",
    "text": "Dank je wel voor het meenemen.",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-96c6591474d5e5b0-4.mp3",
    "sha256": "aa3e5b9cc460cef96ab87426786e4c2508840ad07aefd6cfe38072ee9e6f4356",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-96c6591474d5e5b0-4"
  },
  {
    "id": "k10l-555ce974faa00e27",
    "text": "Er ligt een pakje voor jou bij mij.",
    "voiceId": "DiUBVrSFwkMaPz4XqWvR",
    "src": "/package-audio/dialogue-repair/klink-dialogue-8516816541f86701-1.mp3",
    "sha256": "8c4dd2d590eb24fb64496209b468e6cc074a808adac41962422af664f3b6eba1",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-8516816541f86701-1"
  },
  {
    "id": "k10l-4d9f539e947a9c92",
    "text": "Dank je. Kan ik het vanavond ophalen?",
    "voiceId": "eQIVHCAcQuAFeJps0K5l",
    "src": "/package-audio/dialogue-repair/klink-dialogue-8516816541f86701-2.mp3",
    "sha256": "a2306bd24daa3a3b3ff809e3f33e87420a857ef1ac21b1cfd0ca5c64123c0d74",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-8516816541f86701-2"
  },
  {
    "id": "k10l-ba0344bea4d76733",
    "text": "Ja, na zeven uur ben ik thuis.",
    "voiceId": "DiUBVrSFwkMaPz4XqWvR",
    "src": "/package-audio/dialogue-repair/klink-dialogue-8516816541f86701-3.mp3",
    "sha256": "5fc498ea450f3f257e1e5ddfc97b7981ec65610adf48a4186ae0c45f7b1dd392",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-8516816541f86701-3"
  },
  {
    "id": "k10l-8a8bf8806645d062",
    "text": "Dan kom ik rond half acht.",
    "voiceId": "eQIVHCAcQuAFeJps0K5l",
    "src": "/package-audio/dialogue-repair/klink-dialogue-8516816541f86701-4.mp3",
    "sha256": "9f85a026575a39d2c4f584028e8ca547a9052c2017fa6e002783d877f9d5f48c",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-8516816541f86701-4"
  },
  {
    "id": "k10l-21d88b7d747e9291",
    "text": "Vrijdag",
    "src": "/package-audio/woorden-20261025/TL1826.mp3",
    "sha256": "93aa02d83ace6dc07c718648f94c16b825d24ba1fceb726a562062bce7350d81",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-f72fccfbffccee76",
    "text": "Donderdag",
    "src": "/package-audio/woorden-20261025/TL0378.mp3",
    "sha256": "bd242c6ad619441f1413f84d6ef37cd445cf28558ac29fb583eb0054bf895f04",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-08bced504f2c9330",
    "text": "Maandag",
    "src": "/package-audio/woorden-20261025/TL0903.mp3",
    "sha256": "01a453054224367f869a950f6cd87caf02aefa11d14e096d81cb9b431dac2a97",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-3d1891ea7407e773",
    "text": "Deze laars zit te strak. Hebt u een grotere maat?",
    "voiceId": "5sOQIpQbG4XwqbEbuGNB",
    "src": "/package-audio/dialogue-repair/klink-dialogue-a976bff5b61e3cdb-1.mp3",
    "sha256": "7828f816a087d1dd68f0411172d0d6ff61b363ff0c6121f1496b204542823f23",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-a976bff5b61e3cdb-1"
  },
  {
    "id": "k10l-120c131f5740b3cc",
    "text": "Ja. Wilt u hetzelfde model?",
    "voiceId": "DiUBVrSFwkMaPz4XqWvR",
    "src": "/package-audio/dialogue-repair/klink-dialogue-a976bff5b61e3cdb-2.mp3",
    "sha256": "0110ae561f283f1a256084f56d7b96543518d91d93a81685a862679bc13d1e58",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-a976bff5b61e3cdb-2"
  },
  {
    "id": "k10l-d2a926bdb2175f3e",
    "text": "Graag, als dat er nog is.",
    "voiceId": "5sOQIpQbG4XwqbEbuGNB",
    "src": "/package-audio/dialogue-repair/klink-dialogue-a976bff5b61e3cdb-3.mp3",
    "sha256": "007ef0c551717637de37348612f89a6abb126e55b71c2a33fbc06fe43f5a35a1",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-a976bff5b61e3cdb-3"
  },
  {
    "id": "k10l-b11c8e41edd3abfd",
    "text": "Ik kijk even in het magazijn.",
    "voiceId": "DiUBVrSFwkMaPz4XqWvR",
    "src": "/package-audio/dialogue-repair/klink-dialogue-a976bff5b61e3cdb-4.mp3",
    "sha256": "f7fc84d0e134dc626ee60a2b562da37524c6c83108a6f84d2d7696843222a17c",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-a976bff5b61e3cdb-4"
  },
  {
    "id": "k10l-0fb940ca70ac6afa",
    "text": "Ik wil mijn haar iets korter, maar niet heel kort.",
    "voiceId": "HGg2c3eDR1tMpbtDRAzL",
    "src": "/package-audio/dialogue-repair/klink-dialogue-fcdc7e9ea05435ac-1.mp3",
    "sha256": "40afbebaf4fa78e0c2f6cf37ffbd911b86d7ff8722ed030e579f6800e4c9c7e8",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-fcdc7e9ea05435ac-1"
  },
  {
    "id": "k10l-ec312b130eaca58d",
    "text": "Ongeveer twee centimeter eraf?",
    "voiceId": "Pk1wM1jtot5sJaptlRWQ",
    "src": "/package-audio/dialogue-repair/klink-dialogue-fcdc7e9ea05435ac-2.mp3",
    "sha256": "d8b95b00e56c2c293d82c838d22d250186ae4367e6417e80d22f2c0d3526b614",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-fcdc7e9ea05435ac-2"
  },
  {
    "id": "k10l-c1c40b2f4869506c",
    "text": "Ja, dat lijkt me goed.",
    "voiceId": "HGg2c3eDR1tMpbtDRAzL",
    "src": "/package-audio/dialogue-repair/klink-dialogue-fcdc7e9ea05435ac-3.mp3",
    "sha256": "bf53f71ca4dc30dfc63d695c930273e8d23ced3043c0eb9b5d4ae1bf1e2a145d",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-fcdc7e9ea05435ac-3"
  },
  {
    "id": "k10l-61a4449912ef9c09",
    "text": "Dan beginnen we daarmee.",
    "voiceId": "Pk1wM1jtot5sJaptlRWQ",
    "src": "/package-audio/dialogue-repair/klink-dialogue-fcdc7e9ea05435ac-4.mp3",
    "sha256": "48a65ba30c2e96195cbc258fbb4f64797b5ffe9c7109fc98b7e81cfd5c9e43e8",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-fcdc7e9ea05435ac-4"
  },
  {
    "id": "k10l-de6d52a1322560d0",
    "text": "De verpakking van deze pil is anders. Kunt u dat uitleggen?",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-3c5bcf8119e04e9d-1.mp3",
    "sha256": "abef4cce6583d220fec110b041b0e27f362590b8ca5ce4abe46ad0b6457d196e",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-3c5bcf8119e04e9d-1"
  },
  {
    "id": "k10l-a1e9ec39a9bf03b9",
    "text": "Ja, ik kijk eerst welke verpakking u eerder had.",
    "voiceId": "tfweP7lGJyLeNV9dH1Rm",
    "src": "/package-audio/dialogue-repair/klink-dialogue-3c5bcf8119e04e9d-2.mp3",
    "sha256": "301443aadda3e647a52848efe0684c3fd2fcb21dc88d3b50b84eea1d1dd6df9e",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-3c5bcf8119e04e9d-2"
  },
  {
    "id": "k10l-3ea883e39181333f",
    "text": "Wilt u het daarna rustig uitleggen?",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-3c5bcf8119e04e9d-3.mp3",
    "sha256": "d7f3d2d362d7c141419d30bf6d734648b8653ab8b945b4a7af5945586e8cd7a4",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-3c5bcf8119e04e9d-3"
  },
  {
    "id": "k10l-c26bc33d6f8d50f3",
    "text": "Natuurlijk. En u kunt vragen stellen.",
    "voiceId": "tfweP7lGJyLeNV9dH1Rm",
    "src": "/package-audio/dialogue-repair/klink-dialogue-3c5bcf8119e04e9d-4.mp3",
    "sha256": "b1676e0e8b1f171e7571ea4319dbe5f90339e9a0d54628e49ac92aef96c56cc2",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-3c5bcf8119e04e9d-4"
  },
  {
    "id": "k10l-66257d0a50168595",
    "text": "Mag ik hier zitten? Ik wil even in mijn boek lezen.",
    "voiceId": "5sOQIpQbG4XwqbEbuGNB",
    "src": "/package-audio/dialogue-repair/klink-dialogue-d0a263adf67c1b3c-1.mp3",
    "sha256": "ddcc359dd1440562df7480b4da98956db57628b4fc7e2484f9e23c282b8eb2f9",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-d0a263adf67c1b3c-1"
  },
  {
    "id": "k10l-4c523935e7c0a625",
    "text": "Ja. De stoel bij het raam is ook vrij.",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-d0a263adf67c1b3c-2.mp3",
    "sha256": "2ab1f902158408806ab178260ff59550072af740597e5b40a0ebea4cd5d2c2e8",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-d0a263adf67c1b3c-2"
  },
  {
    "id": "k10l-30086f7188abfc30",
    "text": "Daar zit ik liever, want daar is meer licht.",
    "voiceId": "5sOQIpQbG4XwqbEbuGNB",
    "src": "/package-audio/dialogue-repair/klink-dialogue-d0a263adf67c1b3c-3.mp3",
    "sha256": "8d1962989a981111d2de0db13367a068a7a13b5f1f56134588cc80c6234bb82e",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-d0a263adf67c1b3c-3"
  },
  {
    "id": "k10l-40aec5b4f5aaa97e",
    "text": "Goed, ik zet mijn tas even opzij.",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-d0a263adf67c1b3c-4.mp3",
    "sha256": "428d97cd8ad0f9100f98f61c8987ff7599f0b40f5877c59c8274bec2dd45d1bb",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-d0a263adf67c1b3c-4"
  },
  {
    "id": "k10l-2f11b3f5d040e6f1",
    "text": "Woensdag lukt mij niet. Kan onze afspraak een dag later?",
    "voiceId": "AyQGttFzg1EY7EIKkpHs",
    "src": "/package-audio/dialogue-repair/klink-dialogue-2a0adf55f7bb05f6-1.mp3",
    "sha256": "bbee6fdf04e0af88c72554840528100592ff16a428b99d86be55d8ccbaed2dd6",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-2a0adf55f7bb05f6-1"
  },
  {
    "id": "k10l-624066ec0647ccbf",
    "text": "Donderdag kan ik na zes uur.",
    "voiceId": "YUdpWWny7k5yb4QCeweX",
    "src": "/package-audio/dialogue-repair/klink-dialogue-2a0adf55f7bb05f6-2.mp3",
    "sha256": "664388ad75aa6e8d1ad96d8d233d2e4e033db4d7956cc6dec168c22e556fe8a3",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-2a0adf55f7bb05f6-2"
  },
  {
    "id": "k10l-2f1e1adb7023b559",
    "text": "Zullen we dan om zeven uur afspreken?",
    "voiceId": "AyQGttFzg1EY7EIKkpHs",
    "src": "/package-audio/dialogue-repair/klink-dialogue-2a0adf55f7bb05f6-3.mp3",
    "sha256": "52cd1ffc9fdbb8d51fbba6aefe2d996b8b29cbf404df0cd872c28cb7672978a0",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-2a0adf55f7bb05f6-3"
  },
  {
    "id": "k10l-bc2002162a4473a5",
    "text": "Ja, ik zet het in mijn agenda.",
    "voiceId": "YUdpWWny7k5yb4QCeweX",
    "src": "/package-audio/dialogue-repair/klink-dialogue-2a0adf55f7bb05f6-4.mp3",
    "sha256": "1b0395750c11b2b8c4c0070c966fcd154ff8e86967bae74633efe84158163856",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-2a0adf55f7bb05f6-4"
  },
  {
    "id": "k10l-74f363c67720c99d",
    "text": "Woensdag.",
    "src": "/package-audio/woorden-20261025/TL1925.mp3",
    "sha256": "06a34f0a051d09056d9b43105e7c69250e9eb585f87d06b010f621cb92a8c458",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-c5f6f25b1014cbdb",
    "text": "Donderdag.",
    "src": "/package-audio/woorden-20261025/TL0378.mp3",
    "sha256": "bd242c6ad619441f1413f84d6ef37cd445cf28558ac29fb583eb0054bf895f04",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-f786b031e83f525c",
    "text": "Dinsdag.",
    "src": "/package-audio/woorden-20261025/TL0365.mp3",
    "sha256": "3a5faa7e08ec07162b84f0a6afc6e730e6f6be0dc3872f9c2da6eaef850bdd21",
    "evidence": "data/klink-word-listening.json"
  },
  {
    "id": "k10l-e774f203340400fb",
    "text": "Mijn bus komt later. Ik ben dus ook later bij jou.",
    "voiceId": "0qLmDzgqulxcvv0yf3kg",
    "src": "/package-audio/dialogue-repair/klink-dialogue-0f5bd37ffaa2169c-1.mp3",
    "sha256": "73c64163db36baa7f456d5146427e1ae0d56db6d73416c33b09107a854218b39",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-0f5bd37ffaa2169c-1"
  },
  {
    "id": "k10l-b4c91bc49e27da4a",
    "text": "Weet je ongeveer hoe laat?",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-0f5bd37ffaa2169c-2.mp3",
    "sha256": "39d078ab923aa8670bf62e3c67ddf3178cfa18e1d5fbc1bd2740dd337c6d1bae",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-0f5bd37ffaa2169c-2"
  },
  {
    "id": "k10l-22c3d3ef10a6f771",
    "text": "Nog niet. Ik stuur een bericht als de bus er is.",
    "voiceId": "0qLmDzgqulxcvv0yf3kg",
    "src": "/package-audio/dialogue-repair/klink-dialogue-0f5bd37ffaa2169c-3.mp3",
    "sha256": "7f79064c3925c3987476b017e83e4b2a93e6d9a239966c414baf3f678db379d9",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-0f5bd37ffaa2169c-3"
  },
  {
    "id": "k10l-8c18eab535d3d4bc",
    "text": "Goed, dan wacht ik op je bericht.",
    "voiceId": "OlBRrVAItyi00MuGMbna",
    "src": "/package-audio/dialogue-repair/klink-dialogue-0f5bd37ffaa2169c-4.mp3",
    "sha256": "e507b0c5868c7b2b11d808843879e6d97b0ae153925e171c016d205e40d131f0",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-0f5bd37ffaa2169c-4"
  },
  {
    "id": "k10l-6aeddd0897cb8713",
    "text": "Het hek hier is dicht. Kunnen we wel naar binnen?",
    "voiceId": "7qdUFMklKPaaAVMsBTBt",
    "src": "/package-audio/dialogue-repair/klink-dialogue-5e32514fb6f64108-1.mp3",
    "sha256": "fae86981a6a227dce23d62c7fc51ccfb75a7976f9285b6448b1cf86130e0c049",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-5e32514fb6f64108-1"
  },
  {
    "id": "k10l-d2e3b0629ddeaea5",
    "text": "Ja, aan de zijkant is nog een hek.",
    "voiceId": "0qLmDzgqulxcvv0yf3kg",
    "src": "/package-audio/dialogue-repair/klink-dialogue-5e32514fb6f64108-2.mp3",
    "sha256": "228f50cae5588060e82a5d40f6c218e3b2b60511a77414b5207e84726fcb20ff",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-5e32514fb6f64108-2"
  },
  {
    "id": "k10l-db06f7bc1d808f80",
    "text": "Moeten we links om het gebouw lopen?",
    "voiceId": "7qdUFMklKPaaAVMsBTBt",
    "src": "/package-audio/dialogue-repair/klink-dialogue-5e32514fb6f64108-3.mp3",
    "sha256": "4ee32f47408e0114a088f4c2a854b2d86d28ccca00a16813a7a827948b975272",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-5e32514fb6f64108-3"
  },
  {
    "id": "k10l-595b569330969928",
    "text": "Ja, daar zie je de ingang.",
    "voiceId": "0qLmDzgqulxcvv0yf3kg",
    "src": "/package-audio/dialogue-repair/klink-dialogue-5e32514fb6f64108-4.mp3",
    "sha256": "8f40341ae697e4c342646586a076d971c3fd34218758de69ffd5309657326de1",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-5e32514fb6f64108-4"
  },
  {
    "id": "k10l-2ca538e49c862fed",
    "text": "In de kastdeur die ik kreeg zit een deuk.",
    "voiceId": "eQIVHCAcQuAFeJps0K5l",
    "src": "/package-audio/dialogue-repair/klink-dialogue-6ad301b07b8f3f97-1.mp3",
    "sha256": "acefdc4f7c39fe7404310e407645f4003181205bb21793586ee02d22adbff3d0",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-6ad301b07b8f3f97-1"
  },
  {
    "id": "k10l-22070abf577f5d6e",
    "text": "Kunt u een foto sturen?",
    "voiceId": "tfweP7lGJyLeNV9dH1Rm",
    "src": "/package-audio/dialogue-repair/klink-dialogue-6ad301b07b8f3f97-2.mp3",
    "sha256": "dad3e5e09f50bcea4979a6170cf4a8fc7d0aec546a865adc4b6f600b1bfca84b",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-6ad301b07b8f3f97-2"
  },
  {
    "id": "k10l-d23546edf1fad99a",
    "text": "Ja. Naar welk adres kan die?",
    "voiceId": "eQIVHCAcQuAFeJps0K5l",
    "src": "/package-audio/dialogue-repair/klink-dialogue-6ad301b07b8f3f97-3.mp3",
    "sha256": "94889471d79364c3eb32675241b9e791763ad8ea6c7a4a0c8292a0e304ec7794",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-6ad301b07b8f3f97-3"
  },
  {
    "id": "k10l-6a1fb281cbc79436",
    "text": "Ik geef u onze contactgegevens.",
    "voiceId": "tfweP7lGJyLeNV9dH1Rm",
    "src": "/package-audio/dialogue-repair/klink-dialogue-6ad301b07b8f3f97-4.mp3",
    "sha256": "99deb16ab2eebd2ad44a65066ee5c11600ee1570c22c65b603a259517b41b2b3",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-6ad301b07b8f3f97-4"
  },
  {
    "id": "k10l-91ba32764afc28c0",
    "text": "Mijn afspraak loopt uit. Kun jij mijn kind ophalen?",
    "voiceId": "60CwgZt94Yf7yYIXMDDe",
    "src": "/package-audio/dialogue-repair/klink-dialogue-4923b03beca4ec86-1.mp3",
    "sha256": "f261307e81d7d50193b6ae8b19ce3d07a06e6329ada13c39d4be7b4832b6f2f6",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-4923b03beca4ec86-1"
  },
  {
    "id": "k10l-25d3e85d01480d99",
    "text": "Ja. Hoe laat moet ik er zijn?",
    "voiceId": "D6MRWCKoavI2xUJXmaCb",
    "src": "/package-audio/dialogue-repair/klink-dialogue-4923b03beca4ec86-2.mp3",
    "sha256": "e23c6b6e9055dd463913781e9eb9712d9f20fb5e0ec6e53e1d1637975114bacd",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-4923b03beca4ec86-2"
  },
  {
    "id": "k10l-8ad4969ac7b36550",
    "text": "Om drie uur. Ik bel de opvang dat jij komt.",
    "voiceId": "60CwgZt94Yf7yYIXMDDe",
    "src": "/package-audio/dialogue-repair/klink-dialogue-4923b03beca4ec86-3.mp3",
    "sha256": "f71e75f75e2353544a9d61a7f30f99f8e6b894464febcf97c467592fa848ed14",
    "evidence": "source.existingAudioSequence",
    "sourceTurnId": "klink-dialogue-4923b03beca4ec86-3"
  },
  {
    "id": "k10l-673b03539d372a47",
    "text": "Goed, dan ga ik op tijd weg.",
    "voiceId": "D6MRWCKoavI2xUJXmaCb",
    "src": "/package-audio/dialogue-repair/klink-dialogue-4923b03beca4ec86-4.mp3",
