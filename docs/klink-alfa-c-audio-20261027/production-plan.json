  "clips": [
    {
      "id": "alfa-c-uitleg-3961e33abcbd",
      "text": "Je oefent met winkel, brood en melk. Tik op Luister.",
      "uses": [
        "winkel.start",
        "common.Start In de winkel"
      ]
    },
    {
      "id": "alfa-c-uitleg-8f406c2ba866",
      "text": "Je bent klaar. Je hebt geoefend met winkel, brood en melk.",
      "uses": [
        "winkel.end",
        "common.Afronding In de winkel"
      ]
    },
    {
      "id": "alfa-c-uitleg-9e8cf5313c56",
      "text": "Kijk naar de foto. Tik op Luister. Kijk ook naar het woord.",
      "uses": [
        "winkel.1.spoken",
        "winkel.2.spoken",
        "winkel.3.spoken",
        "bus.1.spoken",
        "bus.2.spoken",
        "bus.3.spoken",
        "thuis.1.spoken",
        "thuis.2.spoken",
        "thuis.3.spoken"
      ]
    },
    {
      "id": "alfa-c-uitleg-c0d2c04700b4",
      "text": "Je hebt geluisterd. Tik op Verder.",
      "uses": [
        "winkel.1.finish_spoken",
        "winkel.2.finish_spoken",
        "winkel.3.finish_spoken",
        "bus.1.finish_spoken",
        "bus.2.finish_spoken",
        "bus.3.finish_spoken",
        "thuis.1.finish_spoken",
        "thuis.2.finish_spoken",
        "thuis.3.finish_spoken"
      ]
    },
    {
      "id": "alfa-c-uitleg-60c4422b9aa3",
      "text": "Tik op Luister. Kijk naar de drie foto’s. Tik op de foto die bij het woord hoort.",
      "uses": [
        "winkel.4.spoken",
        "winkel.5.spoken",
        "winkel.11.spoken",
        "winkel.12.spoken",
        "bus.4.spoken",
