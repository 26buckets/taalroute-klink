    },
    "/package-audio/complete-20261101/zdz-ac-009.mp3": {
      "text": "De badkamer is naast de keuken.",
      "src": "/package-audio/complete-20261101/zdz-ac-009.mp3",
      "id": "KLINK-COMPLETE-ZDZ-AC-009",
      "sha256": "ef22f968dd72361fad61d93ac8b5a766ea0c11313c103e893f4af4bf1631edb5",
