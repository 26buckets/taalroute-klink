    },
    "/package-audio/complete-20261101/zdz-ac-006.mp3": {
      "text": "Dit is mijn zus Sara.",
      "src": "/package-audio/complete-20261101/zdz-ac-006.mp3",
      "id": "KLINK-COMPLETE-ZDZ-AC-006",
      "sha256": "413799e4acbd1ad37759b522528174c2da0529a02ecd9f7a5ce65e5ee43ce569",
