    },
    "/package-audio/complete-20261101/zdz-ac-007.mp3": {
      "text": "Ik praat met mijn vriend.",
      "src": "/package-audio/complete-20261101/zdz-ac-007.mp3",
      "id": "KLINK-COMPLETE-ZDZ-AC-007",
      "sha256": "72177e9e983a0acffbba14c7d919d2345cb8529b4e74178c97a55b8ac22f36a9",
      "evidence": "public/practice-content/complete-20261101/klink-zeg-de-zin-alfa-c-r01-de88622e691b3b65.json"
    },
    "/package-audio/complete-20261101/zdz-ac-008.mp3": {
      "text": "Mijn huis heeft twee kamers.",
      "src": "/package-audio/complete-20261101/zdz-ac-008.mp3",
      "id": "KLINK-COMPLETE-ZDZ-AC-008",
      "sha256": "d7311b647c0de9566f4477876234da3a4cff588dedd4d1457940debbe2f9cf29",
